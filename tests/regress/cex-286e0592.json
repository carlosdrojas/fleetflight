  "invariant": {
    "id": "I1",
    "name": "FAULT_SHUTDOWN_BOUNDED",
    "description": "If the BMS is FAULTED, the inverter stops discharging within 500 ms.",
    "formula": "G( bms=FAULTED ∧ inv=DISCHARGING → (t − i1_since_ms) < 500 )",
    "bound_ms": 500,
    "timer_key": "i1_since_ms"
  },
  "violated_at_ms": 500,
  "violation_duration_ms": 500,
  "bounds": {
    "max_depth": 120,
    "max_injections": 3,
    "horizon_ms": 4000
  },
